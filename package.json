{
  "name": "parley",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "localnet": "bun scripts/localnet.ts",
    "build:contract": "bun scripts/build-contract.ts",
    "deploy:local": "bun packages/relayer/src/cli.ts deploy",
    "relayer": "bun packages/relayer/src/cli.ts",
    "league": "bun packages/league/src/cli.ts",
    "verify": "bun packages/league/src/verify.ts",
    "judge": "bun scripts/judge.ts",
    "web": "bun run --cwd apps/web build && bun run --cwd apps/web preview",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json && bunx tsc --noEmit -p apps/web/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
